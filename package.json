{
  "name": "@sudobility/whisperly_api",
  "version": "1.0.87",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test:unit": "vitest run",
    "lint": "bunx eslint src",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx prettier --write src",
    "format:check": "bunx prettier --check src",
    "verify": "bun run typecheck && bun run lint && bun run test:unit",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:push": "bunx --bun drizzle-kit push",
    "db:studio": "bunx --bun drizzle-kit studio",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@sudobility/test-db-guard": "^1.0.3",
    "@types/bun": "latest",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "drizzle-kit": "~0.31.11",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.0",
    "vitest": "~4.1.12"
  },
  "dependencies": {
    "@hono/zod-validator": "~0.7.6",
    "@sudobility/auth_service": "^1.1.28",
    "@sudobility/entity_service": "^1.0.48",
    "@sudobility/ratelimit_service": "^1.0.46",
    "@sudobility/subscription_service": "^1.0.30",
    "@sudobility/types": "^1.9.75",
    "@sudobility/whisperly_types": "^1.0.42",
    "drizzle-orm": "~0.45.4",
    "firebase-admin": "~13.10.0",
    "hono": "~4.13.13",
    "postgres": "~3.4.9",
    "resend": "~6.34.1",
    "zod": "~3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/whisperly_api.git"
  }
}
